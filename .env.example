# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (Phase 2) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# --- IPO / GMP data provider (Phase 3) ---
# Name of the active provider, e.g. "ipoguru" or "ipoalerts"
IPO_DATA_PROVIDER=
IPO_API_KEY=
IPO_API_BASE_URL=

# --- Scheduled job intervals, in minutes (Phase 3/4) ---
GMP_UPDATE_INTERVAL=15
SUBSCRIPTION_UPDATE_INTERVAL=30

# --- Site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=IPONexa
