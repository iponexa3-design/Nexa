# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (Phase 2) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# --- IPO / GMP data provider (Phase 3) ---
# "manual" reads data/manual-ipo-feed.json (default, works with no signup).
# "http" calls a vendor via IPO_API_BASE_URL/IPO_API_KEY when available.
# "public" uses a public no-key API at IPO_API_BASE_URL (common for free feeds).
IPO_DATA_PROVIDER=manual
IPO_API_KEY=
IPO_API_BASE_URL=
# Comma-separated IPOAlerts list statuses fetched by the ingest job.
# The free plan only supports "open"; paid plans can use
# "open,upcoming,closed,listed,announced".
# On "open" only, IPOs ingested while open still move to "listed" on the site
# (status is recomputed from dates), but upcoming IPOs need a paid status.
IPO_API_STATUSES=open
# Results per list page: 1 on the free plan, up to 3 on the paid plan.
IPO_API_PAGE_LIMIT=1
# "closed" lists every past issue oldest-first; it is read backwards from the
# newest page until records are older than this many days (covers IPOs that
# have closed but not yet listed, plus recent listings).
IPO_API_CLOSED_LOOKBACK_DAYS=21

# Automatic refresh on a long-running server (`npm run build && npm start`,
# e.g. a VPS): "on" refreshes IPOs, GMP, subscription and listing prices
# shortly after start and then every IPO_REFRESH_INTERVAL_MINUTES (min 15).
# Keep it "off" on serverless hosts and in local dev; use the endpoint below.
IPO_REFRESH_SCHEDULER=off
IPO_REFRESH_INTERVAL_MINUTES=180

# Shared secret for the scheduled refresh endpoint GET /api/cron/refresh-ipos
# (send "Authorization: Bearer <CRON_SECRET>"). The endpoint refuses to run
# when this is empty. Generate a long random value.
CRON_SECRET=

# --- Scheduled job intervals, in minutes (Phase 3/4) ---
GMP_UPDATE_INTERVAL=15
SUBSCRIPTION_UPDATE_INTERVAL=30

# --- Site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=IPONexa
